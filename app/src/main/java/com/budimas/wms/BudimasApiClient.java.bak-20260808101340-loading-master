    public JSONObject login(String identity, String password) throws Exception {
        JSONObject payload = new JSONObject();
        payload.put("identity", identity);
        payload.put("email", identity);
        payload.put("username", identity);
        payload.put("login", identity);
        payload.put("password", password);

        try {
            return post("auth/login", payload, "");
        } catch (ApiException firstError) {
            if (firstError.statusCode == 404 || firstError.statusCode == 405 || firstError.statusCode == 422) {
                return post("v1/auth/login", payload, "");
            }
            throw firstError;
        }
    }

