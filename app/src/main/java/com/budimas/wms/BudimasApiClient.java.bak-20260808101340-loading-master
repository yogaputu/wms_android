    private JSONObject get(String path, String token) throws Exception {
        return request("GET", path, null, token);
    }

    private JSONObject post(String path, JSONObject payload, String token) throws Exception {
        return request("POST", path, payload, token);
    }

    private JSONObject request(String method, String path, JSONObject payload, String token) throws Exception {
        URL url = new URL(resolveUrl(path));
        HttpURLConnection connection = (HttpURLConnection) url.openConnection();
        connection.setConnectTimeout(CONNECT_TIMEOUT_MS);
        connection.setReadTimeout(READ_TIMEOUT_MS);
        connection.setRequestMethod(method);
        connection.setRequestProperty("Accept", "application/json");
        connection.setRequestProperty("Content-Type", "application/json; charset=UTF-8");
        if (token != null && !token.trim().isEmpty()) {
            connection.setRequestProperty("Authorization", "Bearer " + token.trim());
        }

        if (payload != null) {
            connection.setDoOutput(true);
            byte[] bytes = payload.toString().getBytes(StandardCharsets.UTF_8);
            connection.setFixedLengthStreamingMode(bytes.length);
            try (OutputStream output = connection.getOutputStream()) {
                output.write(bytes);
            }
        }

        int statusCode = connection.getResponseCode();
        String body = readBody(statusCode >= 200 && statusCode < 400
                ? connection.getInputStream()
                : connection.getErrorStream());

        if (statusCode < 200 || statusCode >= 400) {
            throw new ApiException(statusCode, extractMessage(body, "HTTP " + statusCode));
        }

        if (body == null || body.trim().isEmpty()) {
            return new JSONObject();
        }
        String cleanBody = body.trim();
        if (cleanBody.startsWith("[")) {
            return new JSONObject().put("items", new JSONArray(cleanBody));
        }
        return unwrap(new JSONObject(cleanBody));
    }

    private JSONObject unwrap(JSONObject response) {
        JSONObject data = response.optJSONObject("data");
        if (data != null) {
            return data;
        }
        JSONObject result = response.optJSONObject("result");
        if (result != null) {
            return result;
        }
        JSONObject pages = response.optJSONObject("pages");
        if (pages != null) {
            return pages;
        }
        return response;
    }

    private String readBody(InputStream stream) throws Exception {
        if (stream == null) {
            return "";
        }
        StringBuilder builder = new StringBuilder();
        try (BufferedReader reader = new BufferedReader(new InputStreamReader(stream, StandardCharsets.UTF_8))) {
            String line;
            while ((line = reader.readLine()) != null) {
                builder.append(line);
            }
        }
        return builder.toString();
    }

    private String extractMessage(String body, String fallback) {
        try {
            JSONObject json = new JSONObject(body);
            String message = AuthSession.firstString(json, "message", "error", "msg", "detail", "description");
            if (!message.isEmpty()) {
                return message;
            }
            JSONObject data = json.optJSONObject("data");
            if (data != null) {
                message = AuthSession.firstString(data, "message", "error", "msg", "detail");
                if (!message.isEmpty()) {
                    return message;
                }
            }
            JSONArray skipped = json.optJSONArray("skipped");
            if (skipped != null && skipped.length() > 0) {
                String first = skipped.optString(0, "");
                if (!first.trim().isEmpty()) {
                    return first.trim();
                }
            }
        } catch (Exception ignored) {
        }
        return fallback;
    }

    private String resolveUrl(String path) {
        String cleanPath = path.startsWith("/") ? path.substring(1) : path;
        return AuthSession.API_BASE_URL + cleanPath;
    }

    private String encode(String value) {
        try {
            return java.net.URLEncoder.encode(value == null ? "" : value, "UTF-8").replace("+", "%20");
        } catch (Exception e) {
            return "";
        }
    }

    private void appendQuery(StringBuilder path, String key, String value) {
        if (value == null || value.trim().isEmpty()) {
            return;
        }
        path.append("&").append(key).append("=").append(encode(value.trim()));
    }

    public static class ApiException extends Exception {
        public final int statusCode;

        public ApiException(int statusCode, String message) {
            super(message);
            this.statusCode = statusCode;
        }
    }
