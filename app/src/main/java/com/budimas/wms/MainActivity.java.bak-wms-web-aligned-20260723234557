    private void seedStockOpnameLocations() {
        if (!stockOpnameLocationStatus.isEmpty()) {
            return;
        }
        for (int i = 1; i <= 5; i++) {
            String code = "A-0" + i;
            stockOpnameLocationStatus.put(code, i == 3 || i == 5 ? "Belum Scan" : "Selesai");
            stockOpnameLocationTitipan.put(code, false);
        }
        for (int i = 1; i <= 5; i++) {
            String code = "TT-0" + i;
            stockOpnameLocationStatus.put(code, i == 1 || i == 4 ? "Selesai" : i == 5 ? "Ada Selisih" : "Belum Scan");
            stockOpnameLocationTitipan.put(code, true);
        }
    }

    private void mergeStockOpnameLocations(JSONArray rows) {
        if (rows == null) {
            return;
        }
        int limit = Math.min(rows.length(), 30);
        for (int i = 0; i < limit; i++) {
            JSONObject row = rows.optJSONObject(i);
            if (row == null) {
                continue;
            }
            String code = first(row, "kode_rak", "KodeRak", "location");
            if (code.isEmpty() || stockOpnameLocationStatus.containsKey(code)) {
                continue;
            }
            stockOpnameLocationStatus.put(code, "Belum Scan");
            String type = first(row, "type_rak", "shelf_type", "TipeRak");
            stockOpnameLocationTitipan.put(code, "titipan".equalsIgnoreCase(type));
        }
    }

    private void addStockOpnameLocationSection(LinearLayout parent, String titleText, boolean titipan) {
        parent.addView(space(8));
        parent.addView(sectionTitle(titleText));
        int shown = 0;
        LinearLayout row = horizontal();
        row.setPadding(0, dp(4), 0, dp(4));
        for (String code : stockOpnameLocationStatus.keySet()) {
            boolean isTitipan = Boolean.TRUE.equals(stockOpnameLocationTitipan.get(code));
            if (isTitipan != titipan) {
                continue;
            }
            row.addView(stockOpnameLocationButton(code), new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
            shown++;
            if (shown % 2 == 0) {
                parent.addView(row);
                row = horizontal();
                row.setPadding(0, dp(4), 0, dp(4));
            }
        }
        if (shown % 2 != 0) {
            parent.addView(row);
        }
        if (shown == 0) {
            parent.addView(body("Lokasi " + titleText + " belum tersedia dari API."));
        }
    }

