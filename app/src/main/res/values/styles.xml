<resources>
    <style name="LoadingCalendarDark" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:datePickerStyle">@style/LoadingDatePicker</item>
        <item name="android:colorAccent">#60A5FA</item>
    </style>
    <style name="LoadingCalendarLight" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:datePickerStyle">@style/LoadingDatePicker</item>
        <item name="android:colorAccent">#0B5ED7</item>
    </style>
    <style name="LoadingDatePicker" parent="@android:style/Widget.Material.DatePicker">
        <item name="android:datePickerMode">calendar</item>
    </style>
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/budimas_bg</item>
        <item name="android:colorAccent">@color/budimas_blue</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="SplashTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/splash_black</item>
        <item name="android:colorAccent">@color/budimas_blue</item>
        <item name="android:statusBarColor">@color/splash_black</item>
        <item name="android:navigationBarColor">@color/splash_black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

</resources>
